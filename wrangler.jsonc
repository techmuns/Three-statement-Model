{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vittara",
  "compatibility_date": "2026-01-15",

  // Build the app before deploying. Wrangler runs this command ahead of every
  // `deploy`/`dev`, so a fresh clone (where `dist/` is gitignored and absent)
  // is always built before its assets are served. Without it, `wrangler deploy`
  // aborts because `assets.directory` does not exist — the deploy shows a blank
  // page.
  "build": {
    "command": "npm run build"
  },

  // The Worker (worker/index.js) handles the dynamic /api/* routes
  // (Analyze dispatch + runtime data reads) and falls through to the static
  // assets for everything else via the ASSETS binding.
  "main": "worker/index.js",

  "assets": {
    "directory": "./dist",
    // Exposed to the Worker so it can serve the SPA for non-API routes.
    "binding": "ASSETS",
    // Single-page app: any unknown non-API path returns index.html, not a 404.
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true
  }
}
